-- Хранилище CFG
local cfgStorage = _G.FurdjeCFG_Storage or {}
_G.FurdjeCFG_Storage = cfgStorage

local function updateCFGList()
    for _, child in pairs(cfgListFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local y = 0
    for name, data in pairs(cfgStorage) do
        local btn = Instance.new("TextButton")
        btn.Parent = cfgListFrame
        btn.Size = UDim2.new(1, -10, 0, 32)
        btn.Position = UDim2.new(0, 5, 0, y)
        btn.BackgroundColor3 = Color3.fromRGB(22,22,30)
        btn.BackgroundTransparency = 0.15
        btn.Text = "   " .. name
        btn.TextColor3 = Color3.fromRGB(200,200,220)
        btn.TextSize = 13
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Font = Enum.Font.GothamSemibold
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
        
        local delBtn = Instance.new("TextButton")
        delBtn.Parent = btn
        delBtn.Size = UDim2.new(0, 24, 0, 24)
        delBtn.Position = UDim2.new(1, -30, 0.5, -12)
        delBtn.BackgroundColor3 = Color3.fromRGB(200,40,40)
        delBtn.Text = "✕"
        delBtn.TextColor3 = Color3.fromRGB(255,255,255)
        delBtn.TextSize = 14
        delBtn.Font = Enum.Font.GothamBold
        Instance.new("UICorner", delBtn).CornerRadius = UDim.new(0, 6)
        delBtn.MouseButton1Click:Connect(function()
            cfgStorage[name] = nil
            _G.FurdjeCFG_Storage = cfgStorage
            updateCFGList()
            showNotification(T("CFGDeleted") .. " " .. name, Color3.fromRGB(200,150,40))
        end)
        
        btn.MouseButton1Click:Connect(function()
            cfgNameBox.Text = name
            local data = cfgStorage[name]
            if data then
                selectedWorld = data.World or "1 World"
                selectedMode = data.Mode
                farmSpeed = data.Speed or 110
                isFarming = data.AutoFarm or false
                infJumpEnabled = data.InfJump or false
                flyEnabled = data.Fly or false
                flySpeed = data.FlySpeed or 50
                isChekpozition = data.Chekpozition or false
                checkModelEnabled = data.CheckModel or false
                accentColor = data.Theme or Color3.fromRGB(0,150,255)
                isAdminUnlocked = data.AdminUnlocked or false
                showNotification(T("CFGLoaded") .. " " .. name, Color3.fromRGB(34,197,94))
            end
        end)
        
        y = y + 36
    end
    cfgListFrame.CanvasSize = UDim2.new(0,0,0,y + 10)
end

