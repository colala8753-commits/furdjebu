local function updateModeList()
    for _, child in pairs(modeListFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    local modes = {}
    if farmPoints[selectedWorld] then
        for modeName, _ in pairs(farmPoints[selectedWorld]) do
            table.insert(modes, modeName)
        end
        table.sort(modes, function(a, b)
            return (modeOrder[a] or 99) < (modeOrder[b] or 99)
        end)
    end
    
    if #modes == 0 then
        modeSelectBtn.Text = "   " .. T("NoPoints") .. " ▼"
        selectedMode = nil
        return
    end
    
    for _, modeName in pairs(modes) do
        local btn = Instance.new("TextButton")
