-- Функции античита (удаление опасных объектов)
local function isDangerousObject(name)
    local dangerous = {
        "LavaPart", "Lava_Stage3", "MovingWall",
        "DoorWall1", "GreenDoorKillPart", "RedDoorKillPart",
        "YellowDoorKillPart", "DoorWall2", "DoorWall3",
        "Stage2LocalNPC_Local", "Tumbleweed", "vanilla",
        "EyesLaser", "Stage11LocalNPC_Local", "Stage14LocalNPC_Local"
    }
    for _, d in pairs(dangerous) do
        if name == d then return true end
    end
    local wallNum = name:match("^MovingWall(%d+)$")
    if wallNum then
        local num = tonumber(wallNum)
        if num and num >= 1 and num <= 15 then
            return true
        end
    end
    return false
end

local function removeDangerousObjects()
    task.spawn(function()
        local count = 0
        local descendants = workspace:GetDescendants()
        for i = 1, #descendants do
            local obj = descendants[i]
            if obj and obj.Parent then
                if isDangerousObject(obj.Name) then
                    obj:Destroy()
                end
            end
            count = count + 1
            if count % 300 == 0 then
                task.wait()
            end
        end
    end)
    if not objectRemoverConnection then
        objectRemoverConnection = workspace.DescendantAdded:Connect(function(obj)
            if isDangerousObject(obj.Name) then
                task.defer(function()
                    if obj and obj.Parent then
                        obj:Destroy()
                    end
                end)
            end
        end)
    end
end
removeDangerousObjects()

-- Отключение коллизий
local function setCollision(state)
    if state then
        if not antiCollisionConnection then
            antiCollisionConnection = RunService.Stepped:Connect(function()
                local char = Player.Character
                if char then
                    for _, part in pairs(char:GetDescendants()) do
                        if part:IsA("BasePart") and part.CanCollide then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if antiCollisionConnection then
            antiCollisionConnection:Disconnect()
            antiCollisionConnection = nil
        end
        local char = Player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CanCollide = true
        end
    end
end

-- Телепортация к точке
local function moveTo(targetPos)
    local char = Player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        return false
    end
    local root = char.HumanoidRootPart
    local bodyVel = Instance.new("BodyVelocity")
    bodyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bodyVel.Parent = root
    
    local reached = false
    while isFarming and not reached do
        if not char or not char:FindFirstChild("HumanoidRootPart") then
            break
        end
        local dist = (root.Position - targetPos).Magnitude
        if dist <= 6 then
            reached = true
        else
            local direction = (targetPos - root.Position).Unit
            bodyVel.Velocity = direction * farmSpeed
        end
        task.wait(0.02)
    end
    if bodyVel then bodyVel:Destroy() end
    return reached
end

-- Основной цикл фарма
local function startFarming()
    task.spawn(function()
        while isFarming do
            local worldPoints = farmPoints[selectedWorld]
            local modePoints = worldPoints and worldPoints[selectedMode]
            if modePoints and #modePoints > 0 then
                setCollision(true)
                
                -- Особый случай для Bbnos World +50k cash
                if selectedWorld == "Bbnos World" and selectedMode == "+50k cash" then
                    local success, err = pcall(function()
                        game:GetService("ReplicatedStorage").Remotes.RequestCheckpointTp:FireServer(12, "wins")
                    end)
                    if success then
                        print("Ремоут на чекпоинт отправлен!")
                    else
                        warn("Ошибка ремоута: ", err)
                    end
                    task.wait(0.5)
                end
                
                for i, point in ipairs(modePoints) do
                    if not isFarming then break end
                    moveTo(point)
                    if selectedWorld == "Bbnos World" and selectedMode == "+50k cash" and i == #modePoints then
                        task.wait(1)
                    end
                end
            else
                task.wait(1)
            end
            task.wait(0.1)
        end
        setCollision(false)
        local char = Player.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.WalkSpeed = 16
        end
    end)
end

