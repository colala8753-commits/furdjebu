        isAdminUnlocked = not isAdminUnlocked
    end
    
    if isAdminUnlocked then
        mainFrame.Visible = true
        shadowFrame.Visible = true
        
        local anim1 = accentColor:Create(mainScale, accentColor.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = scale})
        local anim2 = accentColor:Create(shadowScale, accentColor.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = scale})
        anim1:Play()
        anim2:Play()
    else
        local anim1 = accentColor:Create(mainScale, accentColor.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Scale = 0.2})
        local anim2 = accentColor:Create(shadowScale, accentColor.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Scale = 0.2})
        anim2:Play()
        anim1:Play()
        anim1.Completed:Connect(function()
            if not isAdminUnlocked then
                mainFrame.Visible = false
                shadowFrame.Visible = false
            end
        end)
    end
end

