            World = selectedWorld,
            Mode = selectedMode,
            Speed = farmSpeed,
            AutoFarm = isFarming,
            InfJump = infJumpEnabled,
            Fly = flyEnabled,
            FlySpeed = flySpeed,
            Chekpozition = isChekpozition,
            Check = checkModelEnabled,
            Theme = accentColor,
            AdminUnlocked = isAdminUnlocked
        }
        cfgStorage[name] = data
        _G.FurdjeCFG_Storage = cfgStorage
        updateCFGList()
        showNotification(T("CFGSaved") .. " " .. name, Color3.fromRGB(34,197,94))
    else
        showNotification(T("CFGEmpty"), Color3.fromRGB(200,150,40))
    end
end)

cfgLoadBtn.MouseButton1Click:Connect(function()
    local name = cfgNameBox.Text
    if name and name ~= "" and cfgStorage[name] then
        local data = cfgStorage[name]
        selectedWorld = data.World or "1 World"
        selectedMode = data.Mode
        farmSpeed = data.Speed or 110
        isFarming = data.AutoFarm or false
        infJumpEnabled = data.InfJump or false
        flyEnabled = data.Fly or false
        flySpeed = data.FlySpeed or 50
        isChekpozition = data.Chekpozition or false
        checkModelEnabled = data.Check or false
        accentColor = data.Theme or Color3.fromRGB(0,150,255)
        isAdminUnlocked = data.AdminUnlocked or false
        showNotification(T("CFGLoaded") .. " " .. name, Color3.fromRGB(34,197,94))
    else
        showNotification(T("CFGNotFound"), Color3.fromRGB(200,40,40))
    end
end)

