-- Tab switching
local currentTab = "Main"
Pages.Main.Visible = true
TabButtons.Main.BackgroundColor3 = Color3.fromRGB(90, 60, 200)
TabButtons.Main.TextColor3 = Color3.fromRGB(255, 255, 255)

local function SwitchTab(name)
    if currentTab == name then return end
    Pages[currentTab].Visible = false
    TabButtons[currentTab].BackgroundColor3 = Color3.fromRGB(30, 28, 45)
    TabButtons[currentTab].TextColor3 = Color3.fromRGB(160, 150, 180)
    currentTab = name
    Pages[name].Visible = true
    TabButtons[name].BackgroundColor3 = Color3.fromRGB(90, 60, 200)
    TabButtons[name].TextColor3 = Color3.fromRGB(255, 255, 255)
end

for name, btn in pairs(TabButtons) do
    btn.MouseButton1Click:Connect(function()
        SwitchTab(name)
    end)
end

