    noReloadEnabled = state
    if state then
        noReloadConnection = RunService.Heartbeat:Connect(function()
            if noReloadEnabled then
                -- Ищем пистолет в руке или рюкзаке
                local gun = nil
                if character then
                    for _, tool in pairs(character:GetChildren()) do
                        if tool:IsA("Tool") and (tool.Name:lower():find("gun") or tool.Name:lower():find("pistol") or tool.Name:lower():find("revolver")) then
                            gun = tool
                            break
                        end
                    end
                end
                if not gun and player.Backpack then
                    for _, tool in pairs(player.Backpack:GetChildren()) do
                        if tool:IsA("Tool") and (tool.Name:lower():find("gun") or tool.Name:lower():find("pistol") or tool.Name:lower():find("revolver")) then
                            gun = tool
                            break
                        end
                    end
                end
                
                if gun then
                    -- Удаляем перезарядку (Reload)
                    pcall(function()
                        if gun:FindFirstChild("Reload") then
                            gun.Reload:Destroy()
                        end
                        if gun:FindFirstChild("ReloadTime") then
                            gun.ReloadTime.Value = 0
                        end
                        if gun:FindFirstChild("Reloading") then
                            gun.Reloading.Value = false
                        end
                        -- Убираем задержку между выстрелами
                        if gun:FindFirstChild("FireRate") then
                            gun.FireRate.Value = 0
                        end
                        if gun:FindFirstChild("Cooldown") then
                            gun.Cooldown:Destroy()
                        end
                        -- Бесконечные патроны
                        if gun:FindFirstChild("Ammo") then
                            gun.Ammo.Value = 999
                        end
                        if gun:FindFirstChild("MaxAmmo") then
                            gun.MaxAmmo.Value = 999
                        end
                        if gun:FindFirstChild("CurrentAmmo") then
                            gun.CurrentAmmo.Value = 999
                        end
                        -- Отключаем проверки на перезарядку
                        if gun:FindFirstChild("Reloading") then
                            gun.Reloading.Value = false
                        end
                    end)
                end
            end
        end)
    end
end

-- ===== РАННЕЕ ДВИЖЕНИЕ =====
local function updateEarlyMove(state)
    if earlyMoveConnection then
        earlyMoveConnection:Disconnect()
        earlyMoveConnection = nil
    end
    earlyMoveEnabled = state
    if state then
        earlyMoveConnection = RunService.Heartbeat:Connect(function()
            if earlyMoveEnabled and character then
                local humanoid = character:FindFirstChild("Humanoid")
                if humanoid then
                    humanoid:SetStateEnabled(Enum.HumanoidStateType.Running, true)
                    humanoid:SetStateEnabled(Enum.HumanoidStateType.RunningNoPhysics, true)
                    humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
                    humanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing, true)
                    
                    if humanoid:GetState() == Enum.HumanoidStateType.Freefall then
                        humanoid:ChangeState(Enum.HumanoidStateType.Running)
                    end
                    if humanoid:GetState() == Enum.HumanoidStateType.GettingUp then
                        humanoid:ChangeState(Enum.HumanoidStateType.Running)
                    end
                end
            end
        end)
    end
end

-- ===== AUTO BLOCK =====
local function updateAutoBlock(state)
    if autoBlockConnection then
        autoBlockConnection:Disconnect()
        autoBlockConnection = nil
    end
    autoBlockEnabled = state
    if state then
        autoBlockConnection = RunService.Heartbeat:Connect(function()
            if autoBlockEnabled and character then
                local target = nil
                local dist = math.huge
                local myTeam = player.Team
                
                for _, v in pairs(game.Players:GetPlayers()) do
                    if v ~= player and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                        local humanoidCheck = v.Character:FindFirstChild("Humanoid")
                        if humanoidCheck and humanoidCheck.Health > 0 then
                            if myTeam and v.Team then
                                if v.Team ~= myTeam then
                                    local d = (root.Position - v.Character.HumanoidRootPart.Position).Magnitude
                                    if d < dist and d < 15 then
                                        dist = d
                                        target = v
                                    end
                                end
                            else
                                local d = (root.Position - v.Character.HumanoidRootPart.Position).Magnitude
                                if d < dist and d < 15 then
                                    dist = d
                                    target = v
                                end
                            end
                        end
                    end
                end
                
                if target then
                    root.CFrame = CFrame.lookAt(root.Position, target.Character.HumanoidRootPart.Position)
                end
            end
        end)
    end
end

