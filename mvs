-- Вспомогательные функции
local function getChar() return Player.Character end
local function getHRP() local c = getChar() return c and c:FindFirstChild("HumanoidRootPart") end
local function getHumanoid() local c = getChar() return c and c:FindFirstChild("Humanoid") end

-- 1. Teleport
local function teleportTo(pos)
    local hrp = getHRP()
    if hrp then hrp.CFrame = CFrame.new(pos) end
end

-- 2. Infinite Jump
local infJumpConn = nil
local function toggleInfiniteJump()
    local humanoid = getHumanoid()
    if not humanoid then return end
    if infJumpConn then
        infJumpConn:Disconnect()
        infJumpConn = nil
        return
    end
    infJumpConn = humanoid:GetPropertyChangedSignal("Jump"):Connect(function()
        humanoid.Jump = true
    end)
end

-- 3. Speed
local function setSpeed(speed)
    local humanoid = getHumanoid()
    if humanoid then humanoid.WalkSpeed = speed end
end

-- 4. Fly
local flyConn = nil
local function toggleFly()
    local hrp = getHRP()
    if not hrp then return end
    if flyConn then
        flyConn:Disconnect()
        flyConn = nil
        local bv = hrp:FindFirstChildOfClass("BodyVelocity")
        if bv then bv:Destroy() end
        return
    end
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1, 1, 1) * 1e5
    bv.Velocity = Vector3.new(0, 50, 0)
    bv.Parent = hrp
    flyConn = RunService.Heartbeat:Connect(function()
        if bv and bv.Parent then
            bv.Velocity = Vector3.new(0, 50, 0)
        end
    end)
end

-- 5. NoClip
local function toggleNoClip()
    local char = getChar()
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = not part.CanCollide
            end
        end
    end
end

-- 6. God Mode
local godMode = false
local function toggleGodMode()
    local humanoid = getHumanoid()
    if not humanoid then return end
    godMode = not godMode
    if godMode then
        humanoid.MaxHealth = 1e9
        humanoid.Health = 1e9
    else
        humanoid.MaxHealth = 100
        humanoid.Health = 100
    end
end

-- 7. Kill All
local function killAll()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= Player then
            local char = plr.Character
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.Health = 0
            end
        end
    end
end

-- 8. Steal Items
local function stealItems()
    local backpack = Player.Backpack
    for _, item in ipairs(Workspace:GetDescendants()) do
        if item:IsA("Tool") and item.Parent ~= Player and item.Parent ~= backpack then
            item.Parent = backpack
        end
    end
end

-- 9. Auto Farm (имитация)
local farmRunning = false
local function toggleAutoFarm()
    farmRunning = not farmRunning
    if farmRunning then
        task.spawn(function()
            while farmRunning do
                task.wait(0.5)
                local hrp = getHRP()
                if hrp then
                    local target = Workspace:FindFirstChild("FakeFarmPart")
                    if target then hrp.CFrame = target.CFrame end
                end
            end
        end)
    end
end

-- 10. Wall Shoot
local wallShootEnabled = false
local function toggleWallShoot()
    wallShootEnabled = not wallShootEnabled
    if wallShootEnabled then
        local bullets = ReplicatedStorage:FindFirstChild("Bullets") or Workspace:FindFirstChild("Bullets")
        if bullets then
            for _, b in ipairs(bullets:GetChildren()) do
                if b:IsA("BasePart") then b.CanCollide = false end
            end
            bullets.DescendantAdded:Connect(function(child)
                if child:IsA("BasePart") then child.CanCollide = false end
            end)
        end
        print("Wall Shoot ON")
    else
        print("Wall Shoot OFF")
    end
end

-- 11. ESP (улучшенный)
local ESPObjects = {}
local function updateESP()
    for _, obj in pairs(ESPObjects) do obj:Destroy() end
    ESPObjects = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= Player then
            local char = plr.Character
            if char then
                local hl = Instance.new("Highlight")
                hl.Parent = char
                hl.FillColor = Color3.fromRGB(255, 0, 0)
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.Enabled = true
                table.insert(ESPObjects, hl)
            end
        end
    end
end

-- 12. Shoot Murder (MM2)
local function shootMurder()
    local target = nil
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= Player then
            local char = plr.Character
            if char and char:FindFirstChild("Knife") then
                target = plr
                break
            end
        end
    end
    if not target then print("Убийца не найден") return end
    local gun = Player.Backpack:FindFirstChild("Gun") or (getChar() and getChar():FindFirstChild("Gun"))
    if not gun then print("Нет пистолета") return end
    local remote = ReplicatedStorage:FindFirstChild("ShootRemote") or ReplicatedStorage:FindFirstChild("Fire")
    if remote then
        remote:FireServer(target)
        print("Выстрел в убийцу")
    else
        local mouse = Player:GetMouse()
        if mouse then
            local hrp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                mouse.Hit = CFrame.new(hrp.Position)
                mouse.Button1Down:Fire()
                task.wait(0.1)
                mouse.Button1Up:Fire()
                print("Симуляция выстрела")
            end
        end
    end
end

