-- Рабочий Jerk Tool
AddButton(Pages.Fun, "Get Jerk Tool", function()
    local char = LocalPlayer.Character
    if not char then return end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return end

    -- Удаляем старый если есть
    if backpack:FindFirstChild("Jerk Tool") then
        backpack["Jerk Tool"]:Destroy()
    end
    if char:FindFirstChild("Jerk Tool") then
        char["Jerk Tool"]:Destroy()
    end

    local tool = Instance.new("Tool")
    tool.Name = "Jerk Tool"
    tool.RequiresHandle = false
    tool.CanBeDropped = false
    tool.Parent = backpack

    local jerking = false
    local connection

    tool.Activated:Connect(function()
        if jerking then return end
        jerking = true

        local rightArm = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightHand")
        local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
        if not rightArm or not torso then
            jerking = false
            return
        end

        local originalC0
        local motor = rightArm:FindFirstChild("RightShoulder") or torso:FindFirstChild("RightShoulder")
        if motor and motor:IsA("Motor6D") then
            originalC0 = motor.C0
        end

        local t = 0
        connection = RunService.Heartbeat:Connect(function(dt)
            t = t + dt * 8
            local offset = math.sin(t) * 0.35

            if motor and motor:IsA("Motor6D") then
                -- Двигаем руку вниз-вперёд (в сторону паха)
                motor.C0 = originalC0 * CFrame.new(0, -0.6 + offset * 0.15, -0.7) * CFrame.Angles(math.rad(-70 + offset * 25), math.rad(10), math.rad(15))
            else
                -- Fallback для R15
                rightArm.CFrame = torso.CFrame * CFrame.new(1.2, -0.9 + offset * 0.2, -0.6) * CFrame.Angles(math.rad(-80 + offset * 30), 0, math.rad(20))
            end
        end)
    end)

    tool.Deactivated:Connect(function()
        jerking = false
        if connection then
            connection:Disconnect()
            connection = nil
        end
        -- Возвращаем руку
        local rightArm = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightHand")
        local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
        local motor = rightArm and (rightArm:FindFirstChild("RightShoulder") or (torso and torso:FindFirstChild("RightShoulder")))
        if motor and motor:IsA("Motor6D") and originalC0 then
            motor.C0 = originalC0
        end
    end)

    print("Jerk Tool added to backpack")
end)

