-- ====================== HELPERS ======================
local function getValue(name)
    if not name or name == "" then return 0 end
    name = name:gsub("%s+", " "):match("^%s*(.-)%s*$")
    return Values[name] or Values[name:lower()] or 0
end

local function formatNum(n)
    if n >= 1000000 then
        return string.format("%.1fM", n / 1000000)
    elseif n >= 1000 then
        return string.format("%.1fk", n / 1000)
    end
    return tostring(math.floor(n + 0.5))
end

-- ====================== TRADE UI ======================
local function findTradeFrame()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end

    for _, v in ipairs(pg:GetDescendants()) do
        if v:IsA("Frame") or v:IsA("ScrollingFrame") then
            local name = v.Name:lower()
            if (name:find("trade") or name:find("offer")) and v.Visible and v.AbsoluteSize.X > 200 then
                return v
            end
        end
    end
    return nil
end

local function collectItemNames(frame)
    local items = {}
    if not frame then return items end

    for _, desc in ipairs(frame:GetDescendants()) do
        if desc:IsA("TextLabel") or desc:IsA("TextButton") then
            local text = desc.Text
            if text and #text > 1 and #text < 40 and not text:find("%d") and not text:find("VALUE") and not text:find("Decline") and not text:find("Accept") and not text:find("Please") then
                -- фильтруем мусор
                local clean = text:gsub("%s+", " "):match("^%s*(.-)%s*$")
                if Values[clean] or Values[clean:lower()] then
                    table.insert(items, clean)
                end
            end
        end
    end
    return items
end

local function updateOverlay()
    local trade = findTradeFrame()
    if not trade then return end

    -- Пытаемся разделить стороны (очень приблизительно)
    local allItems = collectItemNames(trade)
    local mid = math.ceil(#allItems / 2)
    local yourItems = {}
    local theirItems = {}

    for i, name in ipairs(allItems) do
        if i <= mid then
            table.insert(yourItems, name)
        else
            table.insert(theirItems, name)
        end
    end

    local youVal, themVal = 0, 0
    for _, n in ipairs(yourItems) do youVal += getValue(n) end
    for _, n in ipairs(theirItems) do themVal += getValue(n) end

    local diff = youVal - themVal
    local percent = 0
    if themVal > 0 then
        percent = math.floor((diff / themVal) * 100 + 0.5)
    elseif youVal > 0 then
        percent = 100
    end

    local text = string.format("YOU %s   THEM %s   %s%d   %d%%",
        formatNum(youVal),
        formatNum(themVal),
        diff >= 0 and "+" or "",
        diff,
        percent
    )

    local label = trade:FindFirstChild("ValueOverlay")
    if not label then
        label = Instance.new("TextLabel")
        label.Name = "ValueOverlay"
        label.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        label.BackgroundTransparency = 0.3
        label.BorderSizePixel = 0
        label.Size = UDim2.new(1, -10, 0, 28)
        label.Position = UDim2.new(0, 5, 1, -34)
        label.Font = Enum.Font.GothamBold
        label.TextSize = 15
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.TextStrokeTransparency = 0.6
        label.ZIndex = 50
        label.Parent = trade
    end

    label.Text = text
    label.Visible = true
end

