local function loadScript(scriptCode)
    if scriptCode and scriptCode ~= "" then
        local success, err = pcall(function()
            local func = loadstring(scriptCode)
            if func then
                func()
                print("✅ Скрипт загружен")
            else
                error("Не удалось скомпилировать")
            end
        end)
        if not success then
            warn("❌ Ошибка: " .. tostring(err))
        end
    else
        print("⚠️ Скрипт не добавлен")
    end
end

