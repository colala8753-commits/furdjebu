local function CreateModeButton(yPos, modeName, scriptUrl, color)
    -- Фрейм режима
    local ModeFrame = Instance.new("Frame")
    ModeFrame.Size = UDim2.new(0, 520, 0, 70)
    ModeFrame.Position = UDim2.new(0.5, -260, 0, yPos)
    ModeFrame.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
    ModeFrame.BackgroundTransparency = 0.3
    ModeFrame.BorderSizePixel = 0
    ModeFrame.Parent = Frame
    
    local ModeCorner = Instance.new("UICorner")
    ModeCorner.CornerRadius = UDim.new(0, 15)
    ModeCorner.Parent = ModeFrame
    
    -- Название режима (только название, без скрипта)
    local ModeLabel = Instance.new("TextLabel")
    ModeLabel.Size = UDim2.new(0, 350, 1, 0)
    ModeLabel.Position = UDim2.new(0, 15, 0, 0)
    ModeLabel.BackgroundTransparency = 1
    ModeLabel.Text = modeName
    ModeLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    ModeLabel.TextSize = 20
    ModeLabel.TextXAlignment = Enum.TextXAlignment.Left
    ModeLabel.Font = Enum.Font.Gotham
    ModeLabel.Parent = ModeFrame
    
    -- Кнопка "Играть"
    local PlayButton = Instance.new("TextButton")
    PlayButton.Size = UDim2.new(0, 120, 0, 45)
    PlayButton.Position = UDim2.new(1, -135, 0.5, -22.5)
    PlayButton.BackgroundColor3 = color
    PlayButton.BorderSizePixel = 0
    PlayButton.Text = "Играть"
    PlayButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    PlayButton.TextSize = 18
    PlayButton.Font = Enum.Font.GothamBold
    PlayButton.Parent = ModeFrame
    
    local ButtonCorner = Instance.new("UICorner")
    ButtonCorner.CornerRadius = UDim.new(0, 10)
    ButtonCorner.Parent = PlayButton
    
    -- Эффект наведения
    PlayButton.MouseEnter:Connect(function()
        PlayButton.BackgroundColor3 = Color3.fromRGB(
            math.min(color.R * 255 + 30, 255),
            math.min(color.G * 255 + 30, 255),
            math.min(color.B * 255 + 30, 255)
        )
    end)
    
    PlayButton.MouseLeave:Connect(function()
        PlayButton.BackgroundColor3 = color
    end)
    
    -- Обработчик нажатия (запускает скрипт, но не показывает его в GUI)
    PlayButton.MouseButton1Click:Connect(function()
        loadstring(game:HttpGet(scriptUrl))()
    end)
end

